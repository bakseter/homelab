#!/bin/bash
set -euo pipefail

LOG=/var/log/proxmox-auto-upgrade.log
exec >>"$LOG" 2>&1
echo "=== $(date -u '+%Y-%m-%d %H:%M:%S UTC') run on $(hostname) ==="

if [ -f /var/run/reboot-required ]; then
  echo "Reboot already pending, rebooting now."
  /sbin/reboot
  exit 0
fi

apt-get update
apt-get dist-upgrade -y
apt-get autoremove -y

if [ -f /var/run/reboot-required ]; then
  echo "Reboot required, rebooting."
  /sbin/reboot
else
  echo "No reboot required."
fi
