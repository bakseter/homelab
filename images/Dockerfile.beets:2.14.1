FROM python:3.14-slim@sha256:00ebdcac87ebf7fd62576d8bbe8f8f1e94198befcc4e38c4db9671e61e0dfcfe
 
RUN pip install --no-cache-dir \
      "beets[fetchart]==2.14.0" \
      pillow && \
    rm -rf /root/.cache
 
ENV HOME=/config
ENV BEETSDIR=/config
ENV PYTHONDONTWRITEBYTECODE=1
 
USER 65534:65534
 
ENTRYPOINT ["beet"]
