FROM node:26.12.1-trixie-slim@sha256:36793bcbb160a6a16cede1e62b93f84e26b78a972a8a4c0b879c1c12f22761ec

RUN apt-get update && \
    apt-get install --no-install-recommends -y git

RUN npm install -g \
      @modelcontextprotocol/server-filesystem@2.0.1 \
      @cyanheads/git-mcp-server@2.15.3 \
 && npm cache clean --force

RUN <<EOF cat > /etc/gitconfig
[credential]
    helper = store --file=/etc/git-credentials
EOF

USER 65534:65534

WORKDIR /workspace
