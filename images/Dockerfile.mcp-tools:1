FROM node:26.12.1-trixie-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0

RUN apt-get update && \
    apt-get install --no-install-recommends -y git

RUN npm install -g \
      @modelcontextprotocol/server-filesystem@2.0.1 \
      @cyanheads/git-mcp-server@2.15.3 \
 && npm cache clean --force

RUN <<EOF cat > /etc/gitconfig
[credential]
    helper = store --file=/etc/git-credentials
EOF

USER 65534:65534

WORKDIR /workspace
