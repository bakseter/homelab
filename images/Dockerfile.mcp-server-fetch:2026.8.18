FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim@sha256:db955a4c5fd85c9e08ae2c02f3fcedf76765aebc7c9bc10c55a6bbcc1b0510be AS build

ARG FETCH_VERSION=2026.10.19
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

RUN uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python "mcp-server-fetch==${FETCH_VERSION}"


FROM python:3.14-slim-trixie@sha256:fbecd461fc72d21b2143c6eaba25143738079154a6d0ea3da3aec724f50eed4a

COPY --from=build /app/.venv /app/.venv

ENV PATH=/app/.venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1

USER 65534:65534

ENTRYPOINT ["mcp-server-fetch"]
