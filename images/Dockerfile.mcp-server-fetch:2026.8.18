FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim@sha256:637619278855a77885a94312efa7decd8479ca6cec5f959e134cbab96582821e AS build

ARG FETCH_VERSION=2026.10.19
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

RUN uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python "mcp-server-fetch==${FETCH_VERSION}"


FROM python:3.14-slim-trixie@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8

COPY --from=build /app/.venv /app/.venv

ENV PATH=/app/.venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1

USER 65534:65534

ENTRYPOINT ["mcp-server-fetch"]
