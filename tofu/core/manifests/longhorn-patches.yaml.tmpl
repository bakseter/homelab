apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.longhorn.io/create-default-disk: 'config'
annotations:
  node.longhorn.io/default-disks-config: '[{"path":"/var/mnt/longhorn","allowScheduling":true}]'
%{~ if volume_uuid == "" ~}
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: "'${disk_path}' in disk.symlinks"
  grow: false
%{~ else ~}
---
apiVersion: v1alpha1
kind: ExistingVolumeConfig
name: longhorn
discovery:
  volumeSelector:
    match: volume.uuid == '${volume_uuid}'
%{~ endif ~}
