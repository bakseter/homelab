machine:
  kubelet:
    extraMounts:
      - destination: /var/mnt/longhorn
        type: bind
        source: /var/mnt/longhorn
        options:
          - bind
          - rshared
          - rw

  nodeLabels:
    node.longhorn.io/create-default-disk: "true"

  %{~ if length(extension_image_refs) > 0 ~}
  install:
    extensions:
    %{~ for image_ref in extension_image_refs ~}
      - image: ${image_ref}
    %{~ endfor ~}
  %{~ endif ~}
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: '${path_in_datastore}' in disk.symlinks
  grow: false
