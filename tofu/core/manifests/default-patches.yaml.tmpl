machine:
  time:
    bootTimeout: 2m
  network:
    interfaces:
      - deviceSelector:
          busPath: '0*'
          driver: 'virtio_net'
        dhcp: false
        addresses:
          - ${node_ip}/24
        routes:
          - network: 0.0.0.0/0
            gateway: 192.168.30.1
        %{~ if node_type == "controlplane" ~}
        vip:
          ip: ${virtual_ip_controlplane}
        %{~ endif ~}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  # TODO: don't hardcode schematic
  image: factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:${talos_version}
provisioning:
  diskSelector:
    match: disk.dev_path == '/dev/sda'
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: homelab
endpoint: https://${virtual_ip_controlplane}:6443
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.37.1 # TODO: don't hardcode
extraArgs:
  rotate-server-certificates: true
config:
  imageGCHighThresholdPercent: 60
  imageGCLowThresholdPercent: 40
  imageMinimumGCAge: '5m'
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  bakseter.net/physical-node: ${physical_node_name}
  bakseter.net/node: ${hostname}
---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  forwardKubeDNSToHost: false
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s # one week
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: true
